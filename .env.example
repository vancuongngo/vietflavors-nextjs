# Build-time settings. Both are optional; leave unset for local development.

# Sub-path the site is served from, e.g. "/vietflavors-nextjs" on a GitHub Pages project site.
NEXT_PUBLIC_BASE_PATH=

# Public origin used for sitemap, canonical/Open Graph URLs and JSON-LD.
NEXT_PUBLIC_SITE_ORIGIN=https://vietflavors.se
